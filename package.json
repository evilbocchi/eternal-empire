{
    "name": "eternal-empire",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "jestrbx --place out/sandbox.rbxl",
        "test:plugin": "bun test plugin/**/*.test.js",
        "lint": "eslint src --no-error-on-unmatched-pattern",
        "format": "prettier --write .",
        "asset-sync": "rbxts-asset-sync --log-level=warn --output=src/shared/asset/AssetMap.ts",
        "asset-watch": "rbxts-asset-sync --watch --output=src/shared/asset/AssetMap.ts",
        "build:src": "rbxtsc",
        "build:place": "rojo build --output=out/local.rbxl && lune run src/sandbox/init.luau",
        "build": "bun run build:src && bun run build:place",
        "sandbox": "bun src/sandbox/open.js",
        "docs": "typedoc && bun test/runProgressionEstimate.js",
        "dev": "tsc-watch --compileCommand rbxtsc --onSuccess \"bun run build:place\" --onFirstSuccess \"rojo serve\"",
        "dev:plugin": "concurrently --prefix none \"cd ./plugin && rojo build --plugin ee-tooling.rbxmx --watch\" \"nodemon --watch ./plugin/live ./plugin/live/index.js\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/evilbocchi/eternal-empire.git"
    },
    "bugs": {
        "url": "https://github.com/evilbocchi/eternal-empire/issues"
    },
    "homepage": "https://github.com/evilbocchi/eternal-empire#readme",
    "devDependencies": {
        "@eslint/js": "^9",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@rbxts/compiler-types": "^3.0.0-types.0",
        "@rbxts/coverage": "^0.1.3",
        "@rbxts/types": "^1.0.943",
        "@types/node": "^26.2.0",
        "axios": "^1.19.0",
        "concurrently": "^10.0.4",
        "dotenv": "^17.4.2",
        "eslint": "^9",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-no-relative-import-paths": "^1.6.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-roblox-ts": "^1.4.1",
        "express": "^5.2.1",
        "jest-roblox-assassin": "^1.2.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.6",
        "prettier-plugin-toml": "^2.0.6",
        "rbxluau": "^2.2.0",
        "rbxts-asset-sync": "^0.5.0",
        "rbxts-transform-env": "^3.0.0",
        "rbxts-transformer-flamework": "^1.3.2",
        "rbxts-transformer-services": "^1.1.1",
        "roblox-ts": "^3.0.0",
        "signale": "^1.4.0",
        "tsc-watch": "^7.2.1",
        "typedoc": "^0.28.20",
        "typedoc-material-theme": "^1.4.1",
        "typedoc-plugin-extras": "^4.0.1",
        "typedoc-plugin-missing-exports": "^4.1.4",
        "typedoc-plugin-rename-defaults": "^0.7.3",
        "typescript": "=5.5.3",
        "typescript-eslint": "^8.67.0",
        "ws": "^8.21.3"
    },
    "dependencies": {
        "@antivivi/lemon-signal": "^1.2.4",
        "@antivivi/profileservice": "^1.5.2",
        "@antivivi/rbxnamecolor": "^1.0.1",
        "@antivivi/vrldk": "^1.2.0",
        "@flamework/components": "^1.3.2",
        "@flamework/core": "^1.3.2",
        "@rbxts/camera-shaker": "^1.0.8",
        "@rbxts/ejt": "^2.0.5",
        "@rbxts/flamework-binary-serializer": "^0.7.0",
        "@rbxts/fletchette": "^4.5.0",
        "@rbxts/fuzzy-search": "^1.0.4",
        "@rbxts/janitor": "^1.18.3-ts.0",
        "@rbxts/jest": "^3.16.0-ts.1",
        "@rbxts/jest-globals": "^3.16.0-ts.1",
        "@rbxts/partcache": "^1.1.1",
        "@rbxts/react": "^17.3.7-ts.2",
        "@rbxts/react-devtools-core": "^17.3.7-ts.2",
        "@rbxts/react-globals": "^17.3.7-ts.2",
        "@rbxts/react-roblox": "^17.3.7-ts.2",
        "@rbxts/roman-numerals": "^1.0.2",
        "@rbxts/rparticle": "^1.0.0",
        "@rbxts/serikanum": "^1.6.1",
        "@rbxts/services": "^1.6.0",
        "@rbxts/stringbuilder": "^1.1.0",
        "@rbxts/ui-labs": "^2.4.2",
        "rkkit": "^0.2.0"
    }
}
